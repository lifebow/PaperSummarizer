# Semantic Scholar integration
# Required only for real archive integration tests and live crawls.
SEMANTIC_SCHOLAR_API_KEYS=comma,separated,keys

# OpenAI-compatible LLM integration
# Required only for LLM integration tests and live summarization.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1

# Telegram recap integration
# Required only when sending real Telegram recaps.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me

# Missing integration secrets should skip integration tests instead of failing
# the offline unit harness.

# Bot webhook (optional — only needed for webhook mode, not polling)
BOT_WEBHOOK_URL=
